{
  "manifest_version": 3,
  "name": "Dark Mode for Artificial Analysis — Unofficial",
  "short_name": "AA Dark",
  "version": "0.1.1",
  "description": "A carefully designed dark theme for Artificial Analysis that preserves charts, media, and brand colors.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://artificialanalysis.ai/*"
      ],
      "css": [
        "preflight.css",
        "theme.css"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
